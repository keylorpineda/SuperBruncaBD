# ==============================================================================
# PROYECTO: Sistema Integral de Cadena de Supermercados
# MODULO:   Alta Disponibilidad y Respaldo — Oracle 21c EE (compatible con 26ai Free)
# ARCHIVO:  sql/07_Standby_y_RMAN/05_RMAN_Restore_Recovery_PointInTime.rman
# CURSO:    Administracion de Bases de Datos
# DESCRIPCION:
#   PLANTILLA de Restauracion y Recuperacion con RMAN. NO se ejecuta completa:
#   cada escenario esta COMENTADO a proposito porque restaura sobre la base real.
#   Elija UN escenario, quite los '#' de su bloque, cambie los valores marcados
#   con <...> y ejecutelo conectado a la base en el estado indicado:
#       rman target /
#       RMAN> (pegue el bloque del escenario elegido)
#
#   1. Recuperacion completa ante perdida de datafiles (hasta el ultimo redo disponible:
#      si faltan archivelogs en el servidor, no llega hasta el ultimo commit).
#   2. Recuperacion puntual en el tiempo (Point-In-Time Recovery).
#   3. Restauracion de un solo PDB, sin bajar el CDB completo.
#
#   Requisito: respaldos RMAN (nivel 0 y 1) y archivelogs disponibles en el
#   servidor. El PDB del proyecto se llama PDBCADENA (en Oracle Free: FREEPDB1;
#   verifiquelo con: SELECT name FROM v$pdbs;).
#   El Escenario 3 se probo en Oracle 21c EE: restaura el PDB con el nivel 0 y
#   el nivel 1 y el recovery recupera los datos confirmados despues del respaldo.
# ==============================================================================

# ------------------------------------------------------------------------------
# ESCENARIO 1: RECUPERACION COMPLETA ANTE PERDIDA DE DATAFILES (hasta el ultimo redo disponible)
# Estado requerido: base en MOUNT (SHUTDOWN IMMEDIATE; STARTUP MOUNT;)
# ------------------------------------------------------------------------------
# RUN {
#     ALLOCATE CHANNEL ch1 DEVICE TYPE DISK;
#     ALLOCATE CHANNEL ch2 DEVICE TYPE DISK;
#     RESTORE DATABASE;
#     # RECOVER aplica los incrementales y los archivelogs disponibles
#     RECOVER DATABASE;
#     RELEASE CHANNEL ch1;
#     RELEASE CHANNEL ch2;
# }
# SQL "ALTER DATABASE OPEN";

# ------------------------------------------------------------------------------
# ESCENARIO 2: POINT-IN-TIME RECOVERY (errores humanos: DROP / TRUNCATE masivo)
# Estado requerido: base en MOUNT. Cambie <FECHA HORA> por un instante ANTERIOR
# al error, por ejemplo '2026-11-08 14:30:00'.
# Es una recuperacion INCOMPLETA: se pierde todo lo posterior a esa hora y la
# base se abre con RESETLOGS (nueva encarnacion). Si hay standby, hay que
# reconstruirlo despues (ver Manual de Administracion del Standby, seccion 11).
# ------------------------------------------------------------------------------
# RUN {
#     SET UNTIL TIME "TO_DATE('<FECHA HORA>', 'YYYY-MM-DD HH24:MI:SS')";
#     ALLOCATE CHANNEL ch1 DEVICE TYPE DISK;
#     RESTORE DATABASE;
#     RECOVER DATABASE;
#     RELEASE CHANNEL ch1;
# }
# SQL "ALTER DATABASE OPEN RESETLOGS";

# ------------------------------------------------------------------------------
# ESCENARIO 3: RESTAURAR UN SOLO PDB (la base contenedora sigue abierta)
# Cambie <PDB> por el nombre real (PDBCADENA). Recuperacion completa: no usa
# RESETLOGS y no afecta al standby.
# ------------------------------------------------------------------------------
# SQL "ALTER PLUGGABLE DATABASE <PDB> CLOSE IMMEDIATE";
# RUN {
#     ALLOCATE CHANNEL ch1 DEVICE TYPE DISK;
#     RESTORE PLUGGABLE DATABASE <PDB>;
#     RECOVER PLUGGABLE DATABASE <PDB>;
#     RELEASE CHANNEL ch1;
# }
# SQL "ALTER PLUGGABLE DATABASE <PDB> OPEN";

EXIT;
