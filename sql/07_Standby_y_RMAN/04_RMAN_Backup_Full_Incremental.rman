# ==============================================================================
# PROYECTO: Sistema Integral de Cadena de Supermercados
# MODULO:   Alta Disponibilidad y Respaldo — Oracle 21c EE (compatible con 26ai Free)
# ARCHIVO:  sql/07_Standby_y_RMAN/04_RMAN_Backup_Full_Incremental.rman
# CURSO:    Administracion de Bases de Datos
# DESCRIPCION:
#   Respaldo diario de la base de datos PRINCIPAL con Oracle Recovery Manager.
#   - Nivel 0 (Full): base completa + archivelogs + controlfile (domingos).
#   - Nivel 1 (Incremental): solo bloques cambiados desde el ultimo respaldo.
#   - Validacion de integridad de los respaldos al finalizar.
#
#   El script es PARAMETRIZADO mediante variables de sustitucion de RMAN:
#     &1 = Directorio donde se escriben los respaldos (sin barra final).
#     &2 = Nivel incremental: 0 = full, 1 = incremental.
#
#   Lo ejecuta automaticamente el job CADENA_NEG.JOB_RMAN_BACKUP_DIARIO
#   (DBMS_SCHEDULER, ver 07_Paquete_Jobs_Standby_RMAN.sql) a traves de
#   02_Traslado_Archivelogs_10min_y_Ondemand.ps1 -Modo Backup, que luego copia
#   los respaldos al servidor Standby.
#
# EJECUCION MANUAL (a peticion del academico):
#   Windows: rman target / cmdfile=04_RMAN_Backup_Full_Incremental.rman using 'C:/app/oracle/backups' 0
#   Linux:   rman target / cmdfile=04_RMAN_Backup_Full_Incremental.rman using '/opt/oracle/backups' 1
#   (o desde SQL: EXEC CADENA_NEG.PKG_ADM_STANDBY.PR_RESPALDAR_AHORA;)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACION PERSISTENTE DE RMAN
# ------------------------------------------------------------------------------
CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 14 DAYS;
# OPTIMIZATION OFF: con ON, RMAN omite los datafiles que ya respaldo antes (por ejemplo
# los de PDB$SEED, de solo lectura) y el respaldo nuevo ya no alcanza para reconstruir
# el standby por si solo (RMAN-06023). Con OFF cada respaldo nivel 0 es autosuficiente
# y la carpeta que se traslada al standby basta. Costo: un poco mas de espacio y E/S.
CONFIGURE BACKUP OPTIMIZATION OFF;
CONFIGURE DEFAULT DEVICE TYPE TO DISK;
CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE CONTROLFILE AUTOBACKUP FORMAT FOR DEVICE TYPE DISK TO '&1/ctrl_auto_%F';
CONFIGURE DEVICE TYPE DISK BACKUP TYPE TO COMPRESSED BACKUPSET PARALLELISM 2;
# Los archivelogs solo se pueden borrar si ya se aplicaron en el Standby y
# ademas tienen al menos un respaldo (protege la sincronizacion).
CONFIGURE ARCHIVELOG DELETION POLICY TO APPLIED ON ALL STANDBY BACKED UP 1 TIMES TO DEVICE TYPE DISK;

# ------------------------------------------------------------------------------
# 2. RESPALDO DE LA BASE (NIVEL &2), ARCHIVELOGS Y CONTROLFILE
# ------------------------------------------------------------------------------
RUN {
    ALLOCATE CHANNEL ch1 DEVICE TYPE DISK;
    ALLOCATE CHANNEL ch2 DEVICE TYPE DISK;

    # Cerrar el redo actual para que el respaldo quede consistente
    SQL 'ALTER SYSTEM ARCHIVE LOG CURRENT';

    BACKUP AS COMPRESSED BACKUPSET
        INCREMENTAL LEVEL &2
        DATABASE
        TAG 'CADENA_DIARIO_LVL&2'
        FORMAT '&1/bkp_lvl&2_%d_%T_%U.bkp';

    BACKUP AS COMPRESSED BACKUPSET
        ARCHIVELOG ALL NOT BACKED UP 1 TIMES
        TAG 'CADENA_ARCH_LVL&2'
        FORMAT '&1/bkp_arch_%d_%T_%U.bkp';

    BACKUP CURRENT CONTROLFILE
        TAG 'CADENA_CTRL_LVL&2'
        FORMAT '&1/bkp_ctrl_%d_%T_%U.bkp';

    # Controlfile especial para crear/recrear la base Standby
    BACKUP CURRENT CONTROLFILE FOR STANDBY
        TAG 'CADENA_CTRL_STBY'
        FORMAT '&1/bkp_ctrl_stby_%d_%T_%U.bkp';

    RELEASE CHANNEL ch1;
    RELEASE CHANNEL ch2;
}

# ------------------------------------------------------------------------------
# 3. MANTENIMIENTO DEL CATALOGO Y VALIDACION
# ------------------------------------------------------------------------------
CROSSCHECK BACKUP;
CROSSCHECK ARCHIVELOG ALL;
DELETE NOPROMPT EXPIRED BACKUP;
DELETE NOPROMPT OBSOLETE;

# Verifica que los respaldos se puedan leer y restaurar (no restaura nada)
RESTORE VALIDATE DATABASE;
RESTORE VALIDATE CONTROLFILE;

LIST BACKUP SUMMARY;
EXIT;
